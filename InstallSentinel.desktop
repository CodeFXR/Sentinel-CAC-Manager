[Desktop Entry]
Name=Install Sentinel CAC Manager
GenericName=DoW CAC Setup Wizard
Comment=Graphical Setup Wizard for DoW CAC Middleware, Certificates, and Browser Authentication
Exec=bash -c "K=\"%k\"; K=\"\${K#file://}\"; D=\"\$(dirname \"\$K\" 2>/dev/null || true)\"; [ -z \"\$D\" ] || [ \"\$D\" = \".\" ] && D=\"\$PWD\"; if [ -f \"\$D/install\" ]; then bash \"\$D/install\" --gui; elif [ -f \"\$D/install.sh\" ]; then bash \"\$D/install.sh\" --gui; elif [ -f \"\$HOME/.local/share/sentinel_cac_manager/install\" ]; then bash \"\$HOME/.local/share/sentinel_cac_manager/install\" --gui; else curl -fsSL https://raw.githubusercontent.com/CodeFXR/Sentinel-CAC-Manager/main/install | bash -s -- --gui; fi"
Icon=system-software-install
Terminal=true
Type=Application
Categories=Utility;
Keywords=Install;Setup;CAC;DoW;
StartupNotify=true
StartupWMClass=mil.dow.sentinel_cac_manager.installer
